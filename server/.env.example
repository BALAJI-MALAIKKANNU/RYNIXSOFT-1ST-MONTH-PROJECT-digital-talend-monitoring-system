# Server Port
PORT=5000

# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dtms?retryWrites=true&w=majority

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_admin_sdk_client_email
# Make sure to wrap the private key in quotes and preserve newline characters (\n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# JSON Web Token Secret (used for securing fallback/API routes)
JWT_SECRET=your_jwt_secret_key_at_least_32_chars

# Gmail SMTP Configuration (Nodemailer for sending password reset emails)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# Google Gemini API Key (for description generation, grading suggestions, etc.)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Anthropic API Key (if fallback model is desired)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Cloudinary Storage Configuration (for user uploads / profiling)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Configuration
CLIENT_URL=http://localhost:5173
